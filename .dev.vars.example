# Better-Auth
BETTER_AUTH_SECRET=replace-with-32+char-random-string
BETTER_AUTH_URL=http://localhost:3000
# Email (Resend) — blank keeps mail local: captured to the console, never sent
RESEND_API_KEY=
EMAIL_FROM=FlareStarter <onboarding@resend.dev>
# Optional: Resend audience id for the waitlist (and future newsletter).
# Leave blank to disable audience sync — signups still save to D1.
RESEND_AUDIENCE_ID=
# Social OAuth — blank hides that provider's button
# 本地开发: http://localhost:3000/api/auth/callback/google
# 生产: https://你的域名/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Stripe — blank disables billing. Forward webhooks locally with `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_LIFETIME=
# WeChat Pay on one-time sponsorships, via Stripe's wechat_pay — no WeChat merchant
# account needed. On by default once the Stripe keys are set, but you MUST first enable
# WeChat Pay in Stripe Dashboard -> Payment methods, or clicking it errors out. Set to
# false to pull it offline. Currency and FX rate: features/sponsor/sponsor.config.ts.
STRIPE_WECHAT_PAY_ENABLED=
# Admin — comma-separated emails; these get the admin role on signup/login
ADMIN_EMAILS=
# Cloudflare Turnstile bot protection (signup/login/password reset).
# Both blank = off, and the forms keep working. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile to get the keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Cloudflare Web Analytics (privacy-friendly, free). Blank = no beacon injected.
# Token lives in Dashboard -> Analytics & Logs -> Web Analytics.
CF_ANALYTICS_TOKEN=
# Sentry server-side error reporting. Blank = off. DSN is in the Sentry project settings.
SENTRY_DSN=
# AI provider raw API keys — the selector resolves these lazily by row.kind.
# Set only the vendors you use; the provider registry (admin → AI Providers)
# picks the right one per row. Leave blank locally to keep AI features off
# without crashing startup (env-validate treats all three as optional).
# mmx — domestic vendor; the adapter uses header `x-api-key`, NOT Bearer.
# Get one at https://api.minimax.io (global) or https://api.minimaxi.com (CN).
MMX_API_KEY=
# DeepSeek — domestic; Bearer-auth chat completions, model `deepseek-chat`.
# Get one at https://platform.deepseek.com → API Keys.
DEEPSEEK_API_KEY=
# Replicate — foreign; Bearer-auth async predictions.
# Get one at https://replicate.com/account/api-tokens.
REPLICATE_API_TOKEN=
